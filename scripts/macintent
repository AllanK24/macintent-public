#!/bin/bash
# Explicit live launch; startup never records or submits a request.
set -euo pipefail
[ ! -L "${BASH_SOURCE[0]}" ] || { echo 'Refusing symlinked MacIntent launcher.' >&2; exit 1; }
ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
exec /bin/bash "$ROOT/scripts/dev" uv run --locked --no-sync python -m macintent.server "$@"
